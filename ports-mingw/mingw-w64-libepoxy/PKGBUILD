_realname=libepoxy
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.5.10
pkgrel=8
pkgdesc="A library for handling OpenGL function pointer management for you (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/anholt/libepoxy"
msys2_repository_url='https://github.com/anholt/libepoxy'
license=("spdx:MIT")
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-egl-headers"
         "${MINGW_PACKAGE_PREFIX}-gles-headers")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-meson"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-python"
             "git")
_commit=d1f952c4565c389d82fd1657153e84e050f35b27
_patches=(
  0001-format-trim-spaces-and-use-space-instead-tab.patch
  0002-Test-propagate-NULL-on-wrapped-dlopen-failure.patch
  0003-egl-gl-win32-On-windows-the-mesa-with-EGL-can-suppor.patch
  0004-EGL-has-the-highest-priority.patch
  0005-Add-EGL-support-on-MINGW.patch
  0006-Do-not-try-get_dlopen_handle-in-epoxy_get_bootstrap_.patch
  0007-EGL-gate-core-providers-on-conservative-version.patch
  0008-EGL-track-make-current-for-win32-dispatch-tables.patch
  0009-Ensure-dispatch-table-initialization.patch
  0010-Add-epoxy-apis-for-overriding-default-loading-GL-dll.patch
)
source=("${_realname}"::"git+https://github.com/anholt/libepoxy.git#commit=${_commit}"
        "${_patches[@]}")
sha256sums=('SKIP'
            'd8dd425d55de1242ff9e56b68c7f090c07e51fd7ca1f840195d096caa48aef55'
            '197a2cd35e0188e28a3617ae187d200ba1f9db2c2a42992b3cf911376dc757ee'
            '4159aa196925f4a55351b87cc0adec856b70be2db2e624b89935af24cb58aa7d'
            '758e14650ed520b6891841ced5ee7acb2667c69d10585ecef189a71792e5d831'
            '5b19259efab4d64d845a39eaa877e127be775a94595b01bb7a02e1a3cee5ada7'
            'bc189c018e77a1676cd4ed070709e1b3cf865c589c9803a93394e01505cae9cf'
            '71a6fdd431a9efeea2eb4c1c3178eb5d9ad1a70f9c9652cf7cf42c59a250f206'
            '41f7a00a41126a3c44e04f2b97055ed9ccc25d987a796d64ff81435a590d1c71'
            '6cd139f2730fd3f233544a1c3bf77a1c0b840f73c6c233bcdda8759688e09bc8'
            'fb90dd91b0defa538e364db4fcde46ffcd7e0edf072b7091de20fb8740a6669f')

prepare() {
  cd ${_realname}

  for patch in "${_patches[@]}"; do
    msg2 "Patching with ${patch}"
    patch -Nbp1 -i "${srcdir}/${patch}"
  done
}

build() {
  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
  ${MINGW_PREFIX}/bin/meson.exe setup \
    --prefix="${MINGW_PREFIX}" \
    --buildtype plain \
    -Ddefault_library=both \
    -Degl=yes \
    ../${_realname}

  ${MINGW_PREFIX}/bin/meson.exe compile
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"
  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/meson.exe install

  install -Dm644 "${srcdir}"/${_realname}/COPYING \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/COPYING
}
