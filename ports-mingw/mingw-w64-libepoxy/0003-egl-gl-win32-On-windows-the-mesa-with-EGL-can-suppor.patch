From b5797343886cfa0116b4cd7a69b147e6a5afd4c8 Mon Sep 17 00:00:00 2001
From: Yonggang Luo <luoyonggang@gmail.com>
Date: Tue, 10 Sep 2024 20:41:29 +0800
Subject: [PATCH 03/10] egl/gl/win32: On windows, the mesa with EGL can support
 OpenGL api but it's resident in GLES2_LIB

Signed-off-by: Yonggang Luo <luoyonggang@gmail.com>
---
 src/dispatch_common.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/dispatch_common.c b/src/dispatch_common.c
index 6300b01..6e4508a 100644
--- a/src/dispatch_common.c
+++ b/src/dispatch_common.c
@@ -761,6 +761,11 @@ epoxy_get_core_proc_address(const char *name, int core_version)
 {
 #ifdef _WIN32
     int core_symbol_support = 11;
+#if PLATFORM_HAS_EGL
+    if (epoxy_egl_get_current_gl_context_api() != EGL_NONE) {
+        core_symbol_support = 0;
+    }
+#endif
 #elif defined(__ANDROID__)
     /**
      * All symbols must be resolved through eglGetProcAddress
@@ -829,7 +834,11 @@ epoxy_get_bootstrap_proc_address(const char *name)
         int version = 0;
         switch (epoxy_egl_get_current_gl_context_api()) {
         case EGL_OPENGL_API:
+#if defined(_WIN32)
+            return epoxy_gles2_dlsym(name);
+#else
             return epoxy_gl_dlsym(name);
+#endif
         case EGL_OPENGL_ES_API:
             if (eglQueryContext(eglGetCurrentDisplay(),
                                 eglGetCurrentContext(),
