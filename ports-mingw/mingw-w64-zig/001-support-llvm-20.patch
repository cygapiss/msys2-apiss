diff --git a/lib/libcxx/include/flat_map b/lib/libcxx/include/flat_map
new file mode 100644
index 000000000000..255245008173
--- /dev/null
+++ b/lib/libcxx/include/flat_map
@@ -0,0 +1,83 @@
+// -*- C++ -*-
+//===----------------------------------------------------------------------===//
