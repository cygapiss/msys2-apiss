-            *__st = __does_match;
-            --__n_might_match;
-            ++__n_does_match;
-          }
-        } else {
-          *__st = __doesnt_match;
-          --__n_might_match;
-        }
-      }
-    }
-    // consume if we matched a character
-    if (__consume) {
-      ++__b;
