diff -Naur man-db-2.8.3-orig/gl/lib/strcasecmp.c man-db-2.8.3/gl/lib/strcasecmp.c
--- man-db-2.8.3-orig/gl/lib/strcasecmp.c	1970-01-01 03:00:00.000000000 +0300
+++ man-db-2.8.3/gl/lib/strcasecmp.c	2018-07-02 18:51:10.786349200 +0300
@@ -0,0 +1,62 @@
+/* Case-insensitive string comparison function.
+   Copyright (C) 1998-1999, 2005-2007, 2009-2018 Free Software Foundation, Inc.
+
+   This program is free software; you can redistribute it and/or modify
+   it under the terms of the GNU General Public License as published by
+   the Free Software Foundation; either version 3, or (at your option)
+   any later version.
