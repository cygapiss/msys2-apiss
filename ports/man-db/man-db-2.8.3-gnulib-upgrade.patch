+#endif /* _@GUARD_PREFIX@_SYS_FILE_H */
+#endif /* _@GUARD_PREFIX@_SYS_FILE_H */
diff -Naur man-db-2.8.3-orig/gl/lib/sys_ioctl.in.h man-db-2.8.3/gl/lib/sys_ioctl.in.h
