+#include <getopt-ext.h>
+
+#endif /* _GETOPT_PFX_EXT_H */
diff -Naur man-db-2.8.3-orig/gl/lib/getprogname.c man-db-2.8.3/gl/lib/getprogname.c
--- man-db-2.8.3-orig/gl/lib/getprogname.c	1970-01-01 03:00:00.000000000 +0300
+++ man-db-2.8.3/gl/lib/getprogname.c	2018-07-02 18:50:46.989988100 +0300
@@ -0,0 +1,191 @@
+/* Program name management.
+   Copyright (C) 2016-2018 Free Software Foundation, Inc.
+
+   This program is free software: you can redistribute it and/or modify
+   it under the terms of the GNU General Public License as published by
+   the Free Software Foundation; either version 3 of the License, or
+   (at your option) any later version.
