+++ man-db-2.8.3/gl/lib/flexmember.h	2018-07-02 18:50:42.318720900 +0300
@@ -0,0 +1,45 @@
+/* Sizes of structs with flexible array members.
+
+   Copyright 2016-2018 Free Software Foundation, Inc.
+
