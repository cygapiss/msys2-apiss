+-                          dgettext (state->root_argp->argp_domain,
++                          dgettext (ARGP_TEXT_DOMAIN,
+                                     "\
+ ARGP_HELP_FMT: %s value is less than or equal to %s"),
+                           "rmargin", up->name);
+@@ -220,7 +230,7 @@ fill_in_uparams (const struct argp_state *state)
