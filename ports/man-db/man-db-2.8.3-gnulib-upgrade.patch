-/* remove leading and trailing quotes in requests */
-static void zap_quotes (void)
-{
-	if (*yytext == '"') {
-		if (yytext[yyleng - 1] == '"') {
-			yytext[yyleng - 1] = '\0';
-			yytext++;
-		} else
-			error (OK, 0,
-			       _("%s:%d: unterminated quote in roff request"),
-			       NAME, LINE);
-	}
-}
-#endif
