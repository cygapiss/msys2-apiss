--- man-db-2.8.3-orig/gnulib/lib/malloc.c	2016-11-21 05:45:50.000000000 +0300
+++ man-db-2.8.3/gnulib/lib/malloc.c	1970-01-01 03:00:00.000000000 +0300
@@ -1,56 +0,0 @@
-/* malloc() function that is glibc compatible.
-
