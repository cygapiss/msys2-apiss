diff -Naur man-db-2.8.3-orig/gl/m4/longlong.m4 man-db-2.8.3/gl/m4/longlong.m4
--- man-db-2.8.3-orig/gl/m4/longlong.m4	1970-01-01 03:00:00.000000000 +0300
