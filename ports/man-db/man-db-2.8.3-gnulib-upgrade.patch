+#endif /* _PRINTF_ARGS_H */
diff -Naur man-db-2.8.3-orig/gl/lib/printf-parse.c man-db-2.8.3/gl/lib/printf-parse.c
--- man-db-2.8.3-orig/gl/lib/printf-parse.c	1970-01-01 03:00:00.000000000 +0300
+++ man-db-2.8.3/gl/lib/printf-parse.c	2018-07-02 18:51:01.563821700 +0300
@@ -0,0 +1,638 @@
+/* Formatted output to strings.
+   Copyright (C) 1999-2000, 2002-2003, 2006-2018 Free Software Foundation, Inc.
+
+   This program is free software; you can redistribute it and/or modify
+   it under the terms of the GNU General Public License as published by
+   the Free Software Foundation; either version 3, or (at your option)
+   any later version.
