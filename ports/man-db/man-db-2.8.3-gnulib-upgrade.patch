--- man-db-2.8.3-orig/gl/lib/glthread/lock.c	1970-01-01 03:00:00.000000000 +0300
+++ man-db-2.8.3/gl/lib/glthread/lock.c	2018-07-02 18:50:48.943099800 +0300
