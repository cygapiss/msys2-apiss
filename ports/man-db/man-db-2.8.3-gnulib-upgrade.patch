--- man-db-2.8.3-orig/gl/lib/getopt_int.h	1970-01-01 03:00:00.000000000 +0300
+++ man-db-2.8.3/gl/lib/getopt_int.h	2018-07-02 18:50:46.805977600 +0300
@@ -0,0 +1,118 @@
+/* Internal declarations for getopt.
